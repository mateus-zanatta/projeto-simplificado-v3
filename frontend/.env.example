# =============================================================
# Variáveis de ambiente do front-end (Vite)
# Copie para ".env" e ajuste. Só variáveis com prefixo VITE_ chegam ao navegador,
# por isso NUNCA coloque chaves secretas aqui (a chave da IA fica só no backend).
# =============================================================

# Endereço da API (backend). Em produção, use a URL do Render.
VITE_API_URL=http://localhost:3000
