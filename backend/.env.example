# =============================================================
# Variáveis de ambiente da API - Agenda de Shows
# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NUNCA deve ir para o repositório (já está no .gitignore).
# =============================================================

# Porta em que a API vai rodar
PORT=3000

# Conexão com o PostgreSQL (local, Neon, Render...)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agenda_shows"

# Chave secreta usada para assinar os tokens JWT (use um texto longo e aleatório)
# Dica para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio


# =============================================================
# MÓDULO DE IA (recomendações da tela inicial)
# Basta preencher AI_API_ENDPOINT e AI_API_KEY. A chamada é feita
# SOMENTE pelo backend: a chave nunca chega ao navegador.
# Se ficarem vazias (ou a IA falhar), o sistema usa o fallback local
# e a tela inicial continua funcionando normalmente.
# =============================================================

# URL completa do endpoint no formato chat/completions (padrão OpenAI).
# Exemplos:
#   Google Gemini (chave grátis no Google AI Studio, como nos slides):
#     https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
#   OpenAI:      https://api.openai.com/v1/chat/completions
#   Groq:        https://api.groq.com/openai/v1/chat/completions
#   OpenRouter:  https://openrouter.ai/api/v1/chat/completions
# Outro formato? Ajuste as funções montarRequisicao e extrairTexto em services/iaService.ts
AI_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# Chave de API do provedor (NUNCA commitar)
AI_API_KEY=

# (Opcional) Modelo. Padrão: gemini-3.6-flash
# Ex.: gpt-4o-mini (OpenAI), llama-3.3-70b-versatile (Groq)
AI_MODEL=gemini-3.6-flash

# (Opcional) Tempo máximo de espera pela IA, em milissegundos. Padrão: 15000
AI_TIMEOUT_MS=15000
